      "$reqId": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || (auth.token.email === 'singhpaluppal@gmail.com' && auth.token.email_verified === true))",
        ".write": "auth != null && ((newData.exists() && newData.child('uid').val() === auth.uid && !data.exists()) || (auth.token.email === 'singhpaluppal@gmail.com' && auth.token.email_verified === true))",
        ".validate": "newData.hasChildren(['requestId', 'uid', 'amountRupees', 'status']) && newData.child('amountRupees').isNumber() && newData.child('amountRupees').val() >= 100 && newData.child('amountRupees').val() <= 25000"
      }
    },
    "referrals": {
      ".read": "auth != null",

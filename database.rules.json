    "categories": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'singhpaluppal@gmail.com' && auth.token.email_verified === true"
    },
    "storeConfig": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'singhpaluppal@gmail.com' && auth.token.email_verified === true"
    },
